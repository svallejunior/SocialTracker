# ==============================================================================
# SocialTracker — Variáveis de Ambiente (raiz do projeto)
# ==============================================================================
# Copie para .env e preencha os valores:
#   cp .env.example .env
#
# O .env está no .gitignore. NUNCA faça commit de tokens reais.
# Todos os scripts Python carregam este arquivo via python-dotenv.
# ==============================================================================

# ─── Coleta de dados (Apify) ──────────────────────────────────────────────────
# Token da API do Apify. Usado por ingestion.py, buscar_viral.py e apify.py.
# APIFY_TOKEN é aceito como alias.
APIFY_API_TOKEN=

# ─── Banco de dados ───────────────────────────────────────────────────────────
# Caminho absoluto do SQLite. Se vazio, cada script usa ./instagram_tracker.db
# relativo à raiz do projeto.
DB_PATH=

# ─── Meta Graph API (publicador_instagram.py) ─────────────────────────────────
# Usadas como fallback quando não há registro correspondente em automacao_config.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_ACCOUNT_ID=

# Token por conta. O sufixo é o username em MAIÚSCULAS, com "." trocado por "_".
# São aceitas duas formas: com os underscores das pontas e sem eles.
# Ex.: o perfil "_lunavalente14" aceita META_TOKEN__LUNAVALENTE14 ou META_TOKEN_LUNAVALENTE14.
# META_TOKEN_LUNAVALENTE14=

# URL pública que serve a pasta automacao/ para a Meta baixar a mídia.
# Alternativa ao Supabase Storage; PUBLIC_BASE_URL é aceito como alias.
PUBLIC_MEDIA_BASE_URL=http://localhost:3000

# ─── Supabase Storage (mídias das publicações) ────────────────────────────────
# Bucket público onde as mídias são hospedadas antes de irem para a Meta.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=Postagens

# Mesmos valores expostos ao dashboard Next.js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=Postagens

# ─── Dashboard ────────────────────────────────────────────────────────────────
# Executável Python usado pela rota /api/automacao/executar.
# Windows: python | Linux/macOS: python3
PYTHON_BIN=python
